{
  "name": "dentnord",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/check-build-css.mjs",
    "check:css": "node scripts/check-build-css.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:pages": "tsx prisma/seed-pages.ts",
    "db:studio": "prisma studio",
    "auth:generate": "pnpm dlx auth@1.7.10 generate --config scripts/auth-schema.config.ts --adapter prisma --dialect postgresql --output prisma/schema.prisma -y && prisma format",
    "postinstall": "prisma generate",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^6.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^9.3.1",
    "@uppy/aws-s3": "^6.3.0",
    "@uppy/core": "^6.3.0",
    "@uppy/dashboard": "^6.0.2",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.34.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0"
}
