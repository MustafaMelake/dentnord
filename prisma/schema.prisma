// Dentnord data model.
// - Auth tables (User/Session/Account/Verification) follow Better Auth's schema.
//   Regenerate with `pnpm auth:generate` after adding auth plugins, then re-apply the enum types below.
// - Translatable text fields are JSON: { "da": "...", "en": "..." }.
// - Catalog rows are never hard-deleted once referenced by a case: set `active = false` instead.
// - Measurements are in millimetres; prices are integer minor units (øre) + currency.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Auth (Better Auth) ─────────────────────────────

enum Role {
  ADMIN
  DENTIST
}

enum DentistStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String        @id
  name            String
  email           String        @unique
  emailVerified   Boolean       @default(false)
  image           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  role            Role          @default(DENTIST)
  dentistStatus   DentistStatus @default(PENDING)
  clinicName      String?
  phone           String?
  country         String?
  address         String?
  /// CVR (Denmark) or VAT number. Optional.
  cvr             String?
  preferredLocale String        @default("da")
  /// When the dentist accepted the Terms and the Privacy policy at sign-up.
  termsAcceptedAt DateTime?
  /// Last approve / reject / re-activate by an admin.
  reviewedAt      DateTime?
  /// Reason given when the account was rejected (also sent in the email). Cleared on re-activation.
  rejectionReason String?

  sessions      Session[]
  accounts      Account[]
  cases         Case[]
  uploadedFiles CaseFile[]    @relation("CaseFileUploader")
  caseEvents    CaseEvent[]
  caseMessages  CaseMessage[]
  plansCreated  CasePlan[]    @relation("PlanCreatedBy")
  plansDecided  CasePlan[]    @relation("PlanDecidedBy")
  auditEntries  AuditLog[]
  mediaUploads  MediaAsset[]

  @@index([role, dentistStatus])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth rate limiting (rateLimit.storage = "database"), shared across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  /// Epoch milliseconds.
  lastRequest BigInt

  @@map("rate_limit")
}

// ──────────────────────────────── Audit log ────────────────────────────────

enum AuditAction {
  DENTIST_APPROVED
  DENTIST_REJECTED
  DENTIST_REACTIVATED
  // Admin content management (targetType = model name or "setting:<key>")
  CONTENT_CREATED
  CONTENT_UPDATED
  CONTENT_DELETED
  CONTENT_ARCHIVED
  CONTENT_REORDERED
  MEDIA_UPLOADED
}

/// Who did what, when. Append-only. `targetId` has no foreign key, so entries outlive their target.
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot, so the entry stays readable if the actor is deleted.
  actorEmail String
  /// e.g. "user"
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

// ─────────────────────────────────── Cases ───────────────────────────────────

enum CaseStatus {
  /// Being filled in by the dentist (wizard). Not visible to the lab; no case number yet.
  DRAFT
  SUBMITTED
  NEEDS_FILES
  IN_PLANNING
  AWAITING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

model Case {
  id          String     @id @default(cuid())
  /// Human readable, e.g. DN-2026-0001. Allocated via CaseNumberSequence at submit (null while DRAFT).
  caseNumber  String?    @unique
  /// Pseudonymous code chosen by the dentist. NEVER a patient name (GDPR). Empty while drafting.
  patientCode String     @default("")
  status      CaseStatus @default(DRAFT)
  surgeryDate DateTime?  @db.Date
  notes       String?
  /// When the dentist submitted the case (DRAFT → SUBMITTED).
  submittedAt DateTime?
  /// When the dentist confirmed they may share the files and the patient consented to planning.
  consentAt   DateTime?

  dentistId   String
  dentist     User       @relation(fields: [dentistId], references: [id], onDelete: Restrict)
  /// Required to submit; optional while drafting.
  guideTypeId String?
  guideType   GuideType? @relation(fields: [guideTypeId], references: [id], onDelete: Restrict)

  implants CaseImplant[]
  files    CaseFile[]
  events   CaseEvent[]
  messages CaseMessage[]
  plans    CasePlan[]
  emails   EmailLog[]

  /// When status last changed (set only by server/services/case-workflow.ts).
  statusChangedAt DateTime?
  /// Shipping (SHIPPED): carrier, tracking number and an optional http(s) tracking link.
  shippingCarrier String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dentistId, createdAt(sort: Desc)])
  @@index([dentistId, patientCode])
  @@index([status, updatedAt(sort: Desc)])
  @@index([dentistId, status])
  @@index([guideTypeId])
  @@map("case")
}

/// Per-year counter backing caseNumber (DN-<year>-<0001>). Incremented atomically.
model CaseNumberSequence {
  year      Int @id
  lastValue Int @default(0)

  @@map("case_number_sequence")
}

/// One row per implant site.
model CaseImplant {
  id                 String         @id @default(cuid())
  caseId             String
  case               Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// FDI two-digit notation (11–48).
  fdiTooth           Int
  implantSystemId    String?
  implantSystem      ImplantSystem? @relation(fields: [implantSystemId], references: [id], onDelete: Restrict)
  /// Free text when the system is not in the catalog ("Other").
  implantSystemOther String?
  /// mm. Null = "Let Dentnord suggest".
  diameter           Float?
  /// mm. Null = "Let Dentnord suggest".
  length             Float?
  /// Sleeve / surgical kit for this site (compatible with the implant system). Null = no preference.
  surgicalKitId      String?
  surgicalKit        SurgicalKit?   @relation(fields: [surgicalKitId], references: [id], onDelete: Restrict)
  notes              String?

  @@unique([caseId, fdiTooth])
  @@index([implantSystemId])
  @@index([surgicalKitId])
  @@map("case_implant")
}

enum CaseFileKind {
  CBCT
  INTRAORAL_SCAN
  PHOTO
  /// Lab: the plan report (pdf), required for every plan version.
  PLAN_REPORT
  /// Lab: 3D model of the planned implants (stl/ply/obj/glb), optional.
  PLAN_3D
  /// Lab: the guide design (stl), optional.
  GUIDE_STL
  OTHER
}

enum UploadStatus {
  /// Row created, presign issued, nothing received yet.
  PENDING
  /// Multipart upload in progress.
  UPLOADING
  /// Object verified in R2 (HEAD: exists, size matches).
  COMPLETE
  /// Failed or aborted; the multipart upload was aborted and the object deleted.
  FAILED
}

/// Which jaw an intraoral scan file covers.
enum ScanPart {
  UPPER
  LOWER
  BITE
}

/// Object in the private R2 bucket. Accessed only through short-lived signed URLs.
model CaseFile {
  id           String       @id @default(cuid())
  caseId       String
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind         CaseFileKind
  /// Built by the server: cases/{caseId}/{fileId}/{sanitisedName}. Never taken from the client.
  storageKey   String       @unique
  /// Original file name, sanitised.
  fileName     String
  /// BigInt: CBCT exports can exceed 2 GB. Convert to number/string before sending to the client.
  sizeBytes    BigInt
  mimeType     String
  uploadStatus UploadStatus @default(PENDING)
  /// S3 multipart UploadId while the upload is in progress.
  uploadId     String?
  /// Intraoral scans: upper / lower / bite (optional).
  scanPart     ScanPart?
  /// Lab files (PLAN_REPORT / PLAN_3D / GUIDE_STL) belong to one plan version.
  planId       String?
  plan         CasePlan?    @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Integrity info if available (R2 ETag of the completed object).
  checksum     String?
  completedAt  DateTime?
  uploadedById String
  uploadedBy   User         @relation("CaseFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([caseId, kind])
  @@index([planId])
  @@index([uploadedById])
  @@index([uploadStatus, createdAt])
  @@map("case_file")
}

enum CaseEventType {
  CREATED
  STATUS_CHANGED
  FILE_ADDED
  FILE_FAILED
  FILE_REMOVED
  PLAN_APPROVED
  CHANGES_REQUESTED
  UPDATED
  /// The lab started preparing a new plan version.
  PLAN_CREATED
}

/// Status timeline + audit log. Append-only.
model CaseEvent {
  id         String        @id @default(cuid())
  caseId     String
  case       Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type       CaseEventType
  fromStatus CaseStatus?
  toStatus   CaseStatus?
  /// Null for system events.
  actorId    String?
  actor      User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note       String?
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@index([caseId, createdAt])
  @@index([actorId])
  @@map("case_event")
}

/// Comment thread between the dentist and the lab on a case.
model CaseMessage {
  id         String    @id @default(cuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  /// Who wrote it, as seen by the reader: the dentist, or Dentnord (ADMIN).
  authorRole Role
  /// Admin-only internal note. NEVER shown to (or queryable by) the dentist.
  internal   Boolean   @default(false)
  /// When the other party read it (not used for internal notes).
  readAt     DateTime?
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([caseId, internal, createdAt])
  @@index([authorId])
  @@map("case_message")
}

enum PlanDecision {
  APPROVED
  CHANGES_REQUESTED
}

/// A treatment plan version prepared by the lab. Unsent (sentAt null) while being prepared; the
/// dentist decides on the latest sent version, once. The decision is a legal record: the app never
/// edits or deletes it, and a DB trigger rejects changes to a decided plan.
model CasePlan {
  id          String    @id @default(cuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  version     Int
  /// Optional note for the dentist: { "da": "...", "en": "..." }.
  note        Json?
  createdById String
  createdBy   User      @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  /// When it was sent to the dentist (IN_PLANNING → AWAITING_APPROVAL).
  sentAt      DateTime?

  decision          PlanDecision?
  decidedById       String?
  decidedBy         User?         @relation("PlanDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt         DateTime?
  decisionComment   String?
  /// Approval: the exact statement the dentist confirmed, and in which language.
  approvalStatement String?
  approvalLocale    String?

  files CaseFile[]

  @@unique([caseId, version])
  @@index([caseId, sentAt])
  @@map("case_plan")
}

/// Every email the app sent (or logged without Resend): for the per-case message throttle, for
/// tests and for support. Never contains patient data (subjects carry the case number only).
model EmailLog {
  id        String   @id @default(cuid())
  kind      String
  to        String
  subject   String
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([caseId, kind, createdAt])
  @@map("email_log")
}

// ──────────────────────────── Editable catalogs ────────────────────────────

model Service {
  id          String      @id @default(cuid())
  slug        String      @unique
  /// { da, en }
  title       Json
  /// { da, en }
  summary     Json?
  /// { da, en }
  description Json?
  /// Minor units (øre). Null = "price on request".
  priceAmount Int?
  /// Show the price as "from <price>".
  priceFrom   Boolean     @default(false)
  currency    String      @default("DKK")
  /// { da, en } e.g. "per guide", "excl. VAT"
  priceNote   Json?
  /// lucide-react icon name
  icon        String?
  imageId     String?
  image       MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  published   Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([published, sortOrder])
  @@index([imageId])
  @@map("service")
}

model GuideType {
  id          String   @id @default(cuid())
  slug        String   @unique
  /// { da, en }
  name        Json
  /// { da, en }
  description Json?
  /// Minor units (øre).
  priceAmount Int?
  currency    String   @default("DKK")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cases          Case[]
  portfolioCases PortfolioCase[]

  @@index([active, sortOrder])
  @@map("guide_type")
}

model ImplantSystem {
  id        String   @id @default(cuid())
  brand     String
  line      String
  /// Allowed diameters in mm.
  diameters Float[]
  /// Allowed lengths in mm.
  lengths   Float[]
  notes     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  implants     CaseImplant[]
  surgicalKits SurgicalKit[]

  @@unique([brand, line])
  @@index([active, brand])
  @@map("implant_system")
}

model SurgicalKit {
  id           String   @id @default(cuid())
  name         String   @unique
  manufacturer String?
  /// { da, en }
  description  Json?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Systems this kit is compatible with.
  implantSystems ImplantSystem[]
  implants       CaseImplant[]

  @@index([active, sortOrder])
  @@map("surgical_kit")
}

model PortfolioCase {
  id           String           @id @default(cuid())
  slug         String           @unique
  /// { da, en }
  title        Json
  /// { da, en }
  summary      Json?
  /// { da, en } long-form body
  body         Json?
  guideTypeId  String?
  guideType    GuideType?       @relation(fields: [guideTypeId], references: [id], onDelete: SetNull)
  implantCount Int?
  /// Gallery, in order. The first image is the cover.
  images       PortfolioImage[]
  tags         String[]
  published    Boolean          @default(false)
  publishedAt  DateTime?
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([published, sortOrder])
  @@index([guideTypeId])
  @@map("portfolio_case")
}

model PortfolioImage {
  id        String        @id @default(cuid())
  caseId    String
  case      PortfolioCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  /// { da, en }
  caption   Json?
  sortOrder Int           @default(0)

  @@index([caseId, sortOrder])
  @@index([mediaId])
  @@map("portfolio_image")
}

/// Quote from a dentist. Can only be published with written consent (also a DB CHECK constraint).
model Testimonial {
  id         String   @id @default(cuid())
  /// { da, en }
  quote      Json
  authorName String
  clinic     String?
  consent    Boolean  @default(false)
  published  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("testimonial")
}

/// Public image in the R2 media bucket (R2_MEDIA_BUCKET), served from R2_MEDIA_PUBLIC_URL.
model MediaAsset {
  id           String   @id @default(cuid())
  key          String   @unique
  url          String
  width        Int
  height       Int
  contentType  String
  sizeBytes    Int
  /// { da, en } — required
  alt          Json
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  services        Service[]
  portfolioImages PortfolioImage[]

  @@index([createdAt(sort: Desc)])
  @@index([uploadedById])
  @@map("media_asset")
}

/// Key/value site content (contact info, hero text, ...). Values are JSON, translatable where needed.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_setting")
}

/// Messages from the public contact form, read in /admin/messages. The form asks visitors not to
/// send patient information. No IP address is stored (the rate limiter keys on a hash of it).
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  clinic    String
  email     String
  phone     String?
  message   String
  /// The site language the form was sent from ("da" | "en").
  locale    String
  /// Null = unread.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([readAt])
  @@map("contact_message")
}
