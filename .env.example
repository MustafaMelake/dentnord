# Copy to `.env` and fill in. Never commit `.env`.
# Set SKIP_ENV_VALIDATION=1 to bypass validation (e.g. in CI lint/typecheck jobs).

# --- Database (Neon, EU region) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/dentnord?sslmode=require"

# --- Better Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Cloudflare R2 (bucket created with EU jurisdiction) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="dentnord-cases"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Dentnord <noreply@dentnord.dk>"
ADMIN_EMAIL="info.dentnord@gmail.com"

# --- Seed (only used by `pnpm db:seed`) ---
SEED_ADMIN_PASSWORD=""

# --- Public ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
