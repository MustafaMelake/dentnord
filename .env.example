# Copy to `.env` and fill in. Never commit `.env`.
# Set SKIP_ENV_VALIDATION=1 to bypass validation (e.g. in CI lint/typecheck jobs).

# --- Database (Neon project small-river-39570877, aws-eu-central-1 / Frankfurt) ---
# `neon deploy` / `neon env pull` write DATABASE_URL, DATABASE_URL_UNPOOLED and NEON_BRANCH.
# Pooled (-pooler host): used by the app.
DATABASE_URL=""
# Direct (no -pooler): written by Neon. Copy its value into DIRECT_URL.
DATABASE_URL_UNPOOLED=""
# Direct (no -pooler): used by Prisma Migrate (prisma.config.ts).
DIRECT_URL=""
NEON_BRANCH=""

# --- Better Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Cloudflare R2 (buckets created with EU jurisdiction) ---
# Optional: without real values, image uploads show "not configured" (nothing crashes).
# Account ID: 32 hex chars. API token (Object Read & Write on both buckets): key ID 32 hex, secret 64 hex.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Private bucket for case files (signed URLs only). Formerly R2_BUCKET.
R2_CASES_BUCKET="dentnord-cases"
# Public-read bucket for site images, and the public URL it is served from (custom domain or r2.dev),
# without a trailing slash. Also allowed for next/image at build time.
R2_MEDIA_BUCKET="dentnord-media"
R2_MEDIA_PUBLIC_URL=""

# --- Email (Resend) ---
# Optional. Without a real key (re_…), emails are logged to the server console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Dentnord <noreply@dentnord.dk>"
ADMIN_EMAIL="info.dentnord@gmail.com"

# --- Seed (only used by `pnpm db:seed`): creates the admin (ADMIN_EMAIL) on first run, min 12 chars ---
SEED_ADMIN_PASSWORD=""

# --- Public ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
